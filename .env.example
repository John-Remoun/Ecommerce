# ==========================================================
# Environment variable template. Copy to .env.development
# (or .env.production) and fill in real values.
# Run `node scripts/generate-env.js` to auto-generate a
# .env.development with fresh random secrets.
# ==========================================================

APPLICATION_NAME=Ecommerce
PORT=3000

# MongoDB connection string (required)
DB_URI=mongodb://localhost:27017/ecommerce

# ---- JWT secrets (use long random hex strings in real environments) ----
User_TOKEN_SECRET_KEY=
User_REFRESH_TOKEN_SECRET_KEY=
System_TOKEN_SECRET_KEY=
System_REFRESH_TOKEN_SECRET_KEY=

ACCESS_EXPIRES_IN=1800
REFRESH_EXPIRES_IN=31536000

# ---- Password hashing ----
SALT_ROUND=10

# ---- Field-level encryption (used for phone numbers) ----
# ENC_KEY must be a 64-character hex string (32 bytes)
ENC_KEY=
ENC_BYTE=
ENC_IV_LENGTH=16

# ---- CORS ----
ORIGINS=http://localhost:3000

CLIENT_IDS=

# ---- Email (Gmail SMTP app password) ----
EMAIL_APP=
EMAIL_APP_PASSWORD=

# ---- Social links (optional) ----
FACEBOOK_LINK=
INSTAGRAM_LINK=
TWITTER_LINK=

# ---- Redis (optional; caching / BullMQ queues) ----
REDIS_URI=redis://localhost:6379

# ---- AWS S3 (file uploads) ----
S3_REGION=us-east-1
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_ACCESS_SECRET_KEY=
S3_EXPIRES_IN=120

# ---- Stripe (payments) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email verification enforcement ----
REQUIRE_EMAIL_VERIFICATION=false
